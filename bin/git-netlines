#!/bin/bash
# Uncommitted line counts by type (staged, unstaged, untracked), lockfiles excluded.
cd "$(git rev-parse --show-toplevel)" || exit 1

{
  git diff --cached --numstat | sed 's/^/staged\t/'
  git diff --numstat | sed 's/^/unstaged\t/'
  git ls-files -o --exclude-standard -z | xargs -0 -I{} git diff --no-index --numstat /dev/null {} | sed 's/^/untracked\t/'
} | awk -F'\t' '
  $4 ~ /(\.lock|\.lockb|-lock\.json|-lock\.yaml|go\.sum)$/ { next }
  { add[$1] += $2; del[$1] += $3 }
  function row(label, a, d) {
    printf "%-10s \033[32m%7s\033[0m \033[31m%7s\033[0m", label, "+" a, "-" d
  }
  END {
    split("staged unstaged untracked", types, " ")
    for (i = 1; i <= 3; i++) {
      t = types[i]
      row(t, add[t] + 0, del[t] + 0); print ""
      a += add[t]; d += del[t]
    }
    print "──────────────────────────"
    net = a - d
    color = net > 0 ? "\033[32m" : net < 0 ? "\033[31m" : ""
    row("TOTAL", a, d)
    printf "   \033[1m%sNET %+d\033[0m\n", color, net
  }
'
